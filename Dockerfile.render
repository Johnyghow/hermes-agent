# 使用轻量级环境，彻底抛弃官方笨重的 s6-rc 启动器
FROM python:3.11-slim
WORKDIR /app

# 安装 Git，并保留防超时的 IPv4 优化
RUN apt-get update && apt-get install -y git && \
    echo "precedence ::ffff:0:0/96  100" >> /etc/gai.conf

# Render 的神仙特性：它已经拉取了代码，我们直接 COPY 进来即可，无需再写你的用户名去 clone！
COPY . /app

# 安装 Hermes
RUN pip install --no-cache-dir -e .

# 【Render 专属终极启动脚本】
# 注意第 2 行：我们不再写死 7860 端口，而是直接使用 Render 系统自动分配的 ${PORT}！
# 这将 100% 完美通过 Render 的端口健康检测机制！
RUN echo '#!/bin/bash' > /app/start.sh && \
    echo 'python3 -m http.server ${PORT:-10000} &' >> /app/start.sh && \
    echo 'mkdir -p ~/.hermes' >> /app/start.sh && \
    echo 'cat <<EOF > ~/.hermes/config.yaml' >> /app/start.sh && \
    echo 'llm:' >> /app/start.sh && \
    echo '  provider: openai' >> /app/start.sh && \
    echo '  model: agnes-2.0-flash' >> /app/start.sh && \
    echo 'platforms:' >> /app/start.sh && \
    echo '  telegram:' >> /app/start.sh && \
    echo '    enabled: true' >> /app/start.sh && \
    echo '    token: "${TELEGRAM_TOKEN}"' >> /app/start.sh && \
    echo 'EOF' >> /app/start.sh && \
    echo 'export OPENAI_API_KEY="${AGNES_API_KEY}"' >> /app/start.sh && \
    echo 'export OPENAI_API_BASE="https://apihub.agnes-ai.com/v1"' >> /app/start.sh && \
    echo 'export TELEGRAM_BOT_TOKEN="${TELEGRAM_TOKEN}"' >> /app/start.sh && \
    echo 'hermes gateway run' >> /app/start.sh && \
    chmod +x /app/start.sh

# 将控制权交给启动脚本
CMD ["/app/start.sh"]
