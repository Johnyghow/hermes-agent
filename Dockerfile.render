# 使用轻量级 Python 运行环境
FROM python:3.11-slim
WORKDIR /app

# 安装 Git 和系统依赖
RUN apt-get update && apt-get install -y git && \
    echo "precedence ::ffff:0:0/96  100" >> /etc/gai.conf

# 复制当前目录文件
COPY . /app

# 安装 Hermes Agent
RUN pip install --no-cache-dir -e .

# 【全自动记忆挂载与进化环境启动脚本】
RUN echo '#!/bin/bash' > /app/start.sh && \
    # 1. 容错式挂载：清理旧残留，确保每次拉取最新记忆库
    echo 'echo "正在挂载 agent-mind 记忆库..."' >> /app/start.sh && \
    echo 'rm -rf /app/mind' >> /app/start.sh && \
    echo 'git clone https://x-access-token:${GITHUB_TOKEN}@github.com/johnyghow/agent-mind.git /app/mind' >> /app/start.sh && \
    # 2. 【关键补漏】：赋予 Agent 提交代码的 Git 身份，否则无法保存记忆
    echo 'git config --global user.email "hermes-agent@bot.local"' >> /app/start.sh && \
    echo 'git config --global user.name "Hermes Agent"' >> /app/start.sh && \
    # 3. 【关键补漏】：如果仓库是空的，自动建好分类目录，防止 Hermes 寻址崩溃
    echo 'mkdir -p /app/mind/skills /app/mind/memory /app/mind/tasks' >> /app/start.sh && \
    # 4. 环境变量：将 Hermes 的触角伸进 GitHub 仓库
    echo 'export HERMES_SKILL_PATH=/app/mind/skills' >> /app/start.sh && \
    echo 'export HERMES_MEMORY_PATH=/app/mind/memory' >> /app/start.sh && \
    # 5. 动态注入配置文件 (Discord + 大模型配置)
    echo 'mkdir -p ~/.hermes' >> /app/start.sh && \
    echo 'cat <<EOF > ~/.hermes/config.yaml' >> /app/start.sh && \
    echo 'llm:' >> /app/start.sh && \
    echo '  provider: openai' >> /app/start.sh && \
    echo '  model: agnes-2.0-flash' >> /app/start.sh && \
    echo 'platforms:' >> /app/start.sh && \
    echo '  discord:' >> /app/start.sh && \
    echo '    enabled: true' >> /app/start.sh && \
    echo '    token: "${DISCORD_TOKEN}"' >> /app/start.sh && \
    echo '    channel_id: "${DISCORD_CHANNEL_ID}"' >> /app/start.sh && \
    echo 'EOF' >> /app/start.sh && \
    echo 'export OPENAI_API_KEY="${AGNES_API_KEY}"' >> /app/start.sh && \
    echo 'export OPENAI_API_BASE="https://apihub.agnes-ai.com/v1"' >> /app/start.sh && \
    # 6. 启动伪装心跳与主网关
    echo 'python3 -m http.server ${PORT:-10000} &' >> /app/start.sh && \
    echo 'hermes gateway run' >> /app/start.sh && \
    chmod +x /app/start.sh

# 启动脚本
CMD ["/app/start.sh"]
